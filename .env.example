# -- Backend secrets (NEVER commit the real .env) ---------------------
GROQ_API_KEY=replace_me
NVIDIA_API_KEY=replace_me

# -- Model selection --------------------------------------------------
# Text / multimodal chat model on Groq
GROQ_MODEL=qwen/qwen3.8-27b
# Smaller/faster model used for spoken replies
VOICE_MODEL=llama-3.1-8b-instant
# NVIDIA Nemotron -- used for video & audio understanding
MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning
AUDIO_MODEL=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning

# -- Storage paths ----------------------------------------------------
SQLITE_PATH=./db/agent.db
CHROMA_PATH=./chroma_db
UPLOAD_DIR=./uploads

# -- Telemetry / privacy ----------------------------------------------
ANONYMIZED_TELEMETRY=False

# -- Voice mode limits ------------------------------------------------
# Max bytes for a single voice upload (default 15MB)
MAX_VOICE_AUDIO_BYTES=15728640
# Max characters in a spoken reply (default 2000)
MAX_VOICE_REPLY_CHARS=2000
# Max chars echoed back in the X-Transcript response header (default 500)
MAX_VOICE_TRANSCRIPT_HEADER_CHARS=500

# -- Embedding model (sentence-transformers) --------------------------
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2